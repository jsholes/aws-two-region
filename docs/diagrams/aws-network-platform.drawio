        </mxCell>
        <mxCell id="rt_hyb" value="hybrid route table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="170" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_hyb" value="STATIC  local supernet → inspection&#10;&#10;On-prem prefixes are propagated OUT of&#10;here into the inspection table, never&#10;into the spoke table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;arcSize=8;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="220" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="PROP = aws_ec2_transit_gateway_route_table_propagation      STATIC = aws_ec2_transit_gateway_route&#10;&#10;default_route_table_association and default_route_table_propagation are both disabled on the TGW. That switches off the implicit&#10;behaviour only — every attachment above is placed in its domain explicitly, which is what makes the routing auditable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#B8A02A;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;arcSize=8;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="The single rule that holds the whole design together: the spoke table contains exactly one route out, and it points at the firewall.&#10;Every other domain exists so that some prefix — ingress, remote region, on-premises — can be reachable without being propagated into it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F2;strokeColor=#C7131F;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;arcSize=8;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1">
