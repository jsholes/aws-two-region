          <mxGeometry x="620" y="60" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="rt_ing" value="ingress route table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1">
