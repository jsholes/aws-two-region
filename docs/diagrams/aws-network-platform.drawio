        </mxCell>
        <mxCell id="b_ing" value="PROP    all spoke prefixes&#10;STATIC  0.0.0.0/0 → inspection&#10;&#10;Lets landing-zone workloads egress&#10;through the same firewall as a spoke." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;arcSize=8;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1">
